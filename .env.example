# =============================================================================
# DAVENT — variables de entorno. Copiar a .env (nunca commitear .env).
# En Docker, compose inyecta este archivo con env_file y deriva las URLs.
# =============================================================================

# ---- Núcleo Django ---------------------------------------------------------
SECRET_KEY=change-me-generar-con-secrets.token_urlsafe
DEBUG=False
# ".dominio" cubre apex + subdominios de tienda. localhost/127.0.0.1 son
# necesarios para el healthcheck interno de compose.
ALLOWED_HOSTS=.davent.com,www.davent.com.ar,davent.com.ar,216.24.57.1,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://www.davent.com,https://davent.com
# Permite que la cookie httpOnly de refresh viaje si el front es cross-origin
# (mismo-origen vía nginx/vite-proxy no lo necesita; dejar True es inocuo).
CORS_ALLOW_CREDENTIALS=True
# Solo si algún POST llega cross-origin (admin detrás de otro vhost, etc.)
CSRF_TRUSTED_ORIGINS=https://www.davent.com,https://davent.com,https://*.davent.com
# Canónico: www. El apex redirige 301 a www (nginx) — ver AGENTS.md
# "Dominio y URLs canónicas". Las tiendas son <slug>.davent.com, nunca www.<slug>.
FRONTEND_URL=https://www.davent.com
BACKEND_URL=https://www.davent.com
# Path del admin de Django: OBLIGATORIO no-obvio en producción — con el
# default 'admin/' el `check --deploy` falla (users.E001).
ADMIN_URL=gestion-cambiar-por-un-path-aleatorio/

# ---- Base de datos ----------------------------------------------------------
# Dev local (sin Docker):
DATABASE_URL=sqlite:///db.sqlite3
# Docker: compose arma DATABASE_URL desde estos valores; dejarlos alineados.
POSTGRES_DB=davent
POSTGRES_USER=davent
POSTGRES_PASSWORD=change-me-strong

# ---- Redis / Celery (Docker) -------------------------------------------------
REDIS_PASSWORD=change-me-strong
# compose deriva REDIS_URL (db 1, caché) y CELERY_BROKER_URL (db 0, broker).
# Fuera de Docker: REDIS_URL=redis://:PASS@127.0.0.1:6379/1
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ---- HTTPS detrás de nginx (producción) --------------------------------------
PLATFORM_DOMAIN=davent.com
# Subdominios por tienda <slug>.<dominio> exigen wildcard DNS + cert wildcard
# (profile 'certbot' del compose, ACME DNS-01 con token de Cloudflare) y:
#   ALLOWED_HOSTS=.davent.com              (el punto cubre apex + subdominios)
#   CSRF_TRUSTED_ORIGINS=https://*.davent.com
# Sin wildcard (dominio apuntado a Render): VITE_STORE_SUBDOMAINS=0 en el build
# y los links públicos quedan <dominio>/<slug>.
# El redirect 80->443 lo hace nginx: habilitar solo el header de proxy.
SECURE_PROXY_SSL=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# ---- Email (producción: smtp real; vacío -> consola) --------------------------
# Gmail: EMAIL_HOST=smtp.gmail.com + "contraseña de aplicación" de 16 letras
# (myaccount.google.com/apppasswords, requiere 2FA) — la clave común NO sirve.
# Brevo/Sendinblue: EMAIL_HOST=smtp-relay.brevo.com, HOST_USER = email de login,
# HOST_PASSWORD = SMTP key del panel (no la clave de la cuenta).
# OJO: smtp.office365.com/outlook NO funciona — Microsoft deshabilitó basic auth.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DAVENT <no-reply@davent.com>
LEGAL_REPORTS_EMAIL=davidcv28@outlook.com

# ---- Login social (Google — vacío = feature apagada: botón oculto, 503) -----
# Google: console.cloud.google.com -> Google Auth Platform -> Clientes ->
# "Crear cliente" tipo Aplicación web. Orígenes de JavaScript autorizados:
# http://localhost:5173, http://127.0.0.1:5173 y el dominio de producción.
# Esta var es la única fuente: el backend la usa para verificar el aud del
# token y la sirve al frontend en runtime vía GET /api/config/ — nunca va en
# el código, en el bundle ni en las imágenes. El secret no se usa.
GOOGLE_CLIENT_ID=

# ---- MercadoPago --------------------------------------------------------------
SECRET_MP_KEY=
# Firma HMAC-SHA256 de los webhooks (panel de MP -> Webhooks -> "Clave secreta").
# Vacío en producción: los webhooks se rechazan (401) y `check --deploy` falla.
# En dev se puede procesar sin firma SOLO con el opt-in de abajo.
MP_WEBHOOK_SECRET=
# Bypass de firma SOLO para desarrollo local sin ngrok (además exige DEBUG=True;
# fuera de debug queda inerte). Jamás copiarlo a producción: `check --deploy`
# lo marca como error (payments.E003).
MP_WEBHOOK_ALLOW_UNSIGNED=False
# Solo con credenciales TEST: payer de prueba del mismo site MP.
MP_PAYER_EMAIL=

# ---- Cloudflare R2 (imágenes de tienda) ---------------------------------------
S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Días que se conservan los dumps de `manage.py backup_db` bajo backups/ en R2.
BACKUP_RETENTION_DAYS=14

# ---- APK Android (distribución web directa) -------------------------------------
# Metadata de la APK publicada que GET /api/config/ expone en el bloque 'app'
# para el update checker in-app. Vacíos = sin app publicada (bloque ausente).
# Se actualizan en cada release (lo imprime `manage.py publish_apk`).
APP_APK_VERSION_NAME=
APP_APK_VERSION_CODE=
APP_APK_URL=
# Opcional: versionCode mínimo soportado — abajo de esto el aviso es bloqueante.
APP_APK_MIN_SUPPORTED_CODE=

# ---- Emisor de comprobantes ----------------------------------------------------
ISSUER_NAME=DAVENT
ISSUER_CUIT=
ISSUER_ADDRESS=
ISSUER_EMAIL=
ISSUER_TAX_CONDITION=MO
ISSUER_IIBB=
ISSUER_ACTIVITY_START=

# ---- ARCA (ex-AFIP) — factura electrónica con CAE ------------------------------
# Apagado por defecto: los comprobantes se emiten como internos. Cuando te des
# de alta en el monotributo, los pasos son:
#   1. Generar clave privada + CSR:  openssl req -newkey rsa:2048 -nodes \
#      -keyout afip.key -out afip.csr -subj "/CN=davent/serialNumber=CUIT 20XXXXXXXXX"
#   2. ARCA -> Administración de Certificados Digitales -> subir afip.csr y
#      bajar el .crt emitido.
#   3. ARCA -> Administrador de Relaciones de Clave Fiscal -> habilitar el
#      certificado para el web service "wsfe" (factura electrónica).
#   4. Crear un punto de venta tipo "Web Service" (es el `pos` de las facturas,
#      por defecto 1) en Comprobantes en línea / WSFE.
#   5. Probar primero en homologación (AFIP_ENV=testing con un cert de testing:
#      mismo trámite en el ambiente de homologación de ARCA) y recién después
#      AFIP_ENV=production con el cert definitivo.
# AFIP_CERT/AFIP_KEY aceptan el PEM inline (con \n) o la ruta al archivo.
AFIP_ENABLED=False
AFIP_ENV=testing
AFIP_CUIT=
AFIP_CERT=
AFIP_KEY=
# Passphrase de la clave privada (opcional — solo si el PEM viene protegido).
# También acepta un token enc:v1: para no dejarla en claro:
#   manage.py encrypt_secret --purpose AFIP_KEY_PASSPHRASE --file pass.txt
AFIP_KEY_PASSPHRASE=
# En producción AFIP_KEY va CIFRADA (enc:v1:...) o como ruta a un archivo montado;
# una clave PEM inline en claro solo se acepta con DEBUG=True.
#   1. manage.py encrypt_secret --gen-master-key k1   -> pegar en SECRETS_MASTER_KEYS
#   2. manage.py encrypt_secret --purpose AFIP_KEY --file clave.key -> pegar en AFIP_KEY
# Si es ruta a archivo (Linux): no puede ser legible por otros — chmod 600.
# Rotación de llaves maestras (SECRETS_MASTER_KEYS, keyring "kid:b64url32"):
#   1. manage.py encrypt_secret --gen-master-key k2  -> la llave NUEVA va PRIMERA
#      en la lista ("k2:...,k1:...") — la primera cifra, todas descifran.
#   2. manage.py encrypt_secret --purpose AFIP_KEY --rotate "enc:v1:k1:..."
#      -> re-cifrar cada secreto suelto (AFIP_KEY/AFIP_CERT/AFIP_KEY_PASSPHRASE).
#   3. manage.py rotate_encrypted_fields -> re-cifra la PII de los perfiles en
#      la base (idempotente, por lotes: reanudable si se corta a mitad).
#   4. Recién cuando el comando no reporte más filas re-cifradas, retirar k1
#      de la lista — con eso los blobs viejos quedan ilegibles (rotación real).
SECRETS_MASTER_KEYS=
# Llave HMAC de las huellas de búsqueda (document_hash/phone_hash de
# UserProfile): NUNCA la misma que la keyring de cifrado. Generar cualquier
# valor aleatorio (ej. otra salida de encrypt_secret --gen-master-key h1,
# pegando solo la parte b64url). Vacía = deriva del SECRET_KEY (solo dev/test;
# el deploy check users.E003 la exige en producción). NO ROTARLA en caliente:
# las huellas ya emitidas dependen de ella — rotarla rompe la unicidad.
SECRETS_HASH_KEY=
