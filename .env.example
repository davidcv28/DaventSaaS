# =============================================================================
# DAVENT — variables de entorno. Copiar a .env (nunca commitear .env).
# En Docker, compose inyecta este archivo con env_file y deriva las URLs.
# =============================================================================

# ---- Núcleo Django ---------------------------------------------------------
SECRET_KEY=change-me-generar-con-secrets.token_urlsafe
DEBUG=False
# ".dominio" cubre apex + subdominios de tienda. localhost/127.0.0.1 son
# necesarios para el healthcheck interno de compose.
ALLOWED_HOSTS=.davent.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://davent.com,https://www.davent.com
# Permite que la cookie httpOnly de refresh viaje si el front es cross-origin
# (mismo-origen vía nginx/vite-proxy no lo necesita; dejar True es inocuo).
CORS_ALLOW_CREDENTIALS=True
# Solo si algún POST llega cross-origin (admin detrás de otro vhost, etc.)
CSRF_TRUSTED_ORIGINS=https://davent.com,https://*.davent.com
FRONTEND_URL=https://davent.com
BACKEND_URL=https://api.davent.com

# ---- Base de datos ----------------------------------------------------------
# Dev local (sin Docker):
DATABASE_URL=sqlite:///db.sqlite3
# Docker: compose arma DATABASE_URL desde estos valores; dejarlos alineados.
POSTGRES_DB=davent
POSTGRES_USER=davent
POSTGRES_PASSWORD=change-me-strong

# ---- Redis / Celery (Docker) -------------------------------------------------
REDIS_PASSWORD=change-me-strong
# compose deriva REDIS_URL (db 1, caché) y CELERY_BROKER_URL (db 0, broker).
# Fuera de Docker: REDIS_URL=redis://:PASS@127.0.0.1:6379/1
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ---- HTTPS detrás de nginx (producción) --------------------------------------
PLATFORM_DOMAIN=davent.com
# El redirect 80->443 lo hace nginx: habilitar solo el header de proxy.
SECURE_PROXY_SSL=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# ---- Email (producción: smtp real; vacío -> consola) --------------------------
# Gmail: EMAIL_HOST=smtp.gmail.com + "contraseña de aplicación" de 16 letras
# (myaccount.google.com/apppasswords, requiere 2FA) — la clave común NO sirve.
# Brevo/Sendinblue: EMAIL_HOST=smtp-relay.brevo.com, HOST_USER = email de login,
# HOST_PASSWORD = SMTP key del panel (no la clave de la cuenta).
# OJO: smtp.office365.com/outlook NO funciona — Microsoft deshabilitó basic auth.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DAVENT <no-reply@davent.com>
LEGAL_REPORTS_EMAIL=davidcv28@outlook.com

# ---- MercadoPago --------------------------------------------------------------
SECRET_MP_KEY=
# Firma HMAC-SHA256 de los webhooks (panel de MP -> Webhooks -> "Clave secreta").
# Vacío en dev: se loguea un warning y el webhook se procesa igual.
MP_WEBHOOK_SECRET=
# Solo con credenciales TEST: payer de prueba del mismo site MP.
MP_PAYER_EMAIL=

# ---- Cloudflare R2 (imágenes de tienda) ---------------------------------------
S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Días que se conservan los dumps de `manage.py backup_db` bajo backups/ en R2.
BACKUP_RETENTION_DAYS=14

# ---- Emisor de comprobantes ----------------------------------------------------
ISSUER_NAME=DAVENT
ISSUER_CUIT=
ISSUER_ADDRESS=
ISSUER_EMAIL=
ISSUER_TAX_CONDITION=MO
ISSUER_IIBB=
ISSUER_ACTIVITY_START=
