# Vhosts DAVENT — nginx:unprivileged procesa este template con envsubst al
# arrancar (solo se sustituye ${PLATFORM_DOMAIN}; las $vars de nginx no se tocan).
# Puertos 8080/8443: el contenedor corre como uid 101 (sin root, sin
# NET_BIND_SERVICE) y Docker mapea 80->8080 / 443->8443.

server_tokens off;

# Rate limit extra por IP para el endpoint de login JWT (además del throttle
# 'login' de DRF): 5 req/min con burst corto.
limit_req_zone $binary_remote_addr zone=api_token:10m rate=5r/m;

upstream davent_api {
    server api:8000;
    keepalive 32;
}

# ---------- Vhost por defecto: descarta hosts desconocidos ----------
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    # Healthcheck interno de Docker (compose), sin logging ni datos.
    location = /healthz { access_log off; return 200 'ok'; }

    # Cualquier otro Host no autorizado -> conexión cortada sin respuesta.
    location / { return 444; }
}

# ---------- HTTP del dominio: solo ACME + redirect a HTTPS ----------
server {
    listen 8080;
    listen [::]:8080;
    # ".dominio" cubre apex + todos los subdominios de tienda (<slug>.dominio).
    server_name .${PLATFORM_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- Apex -> www (canónico: www.${PLATFORM_DOMAIN}) ----------
# Exacto (sin punto inicial) para ganarle al server_name wildcard de abajo:
# nginx prioriza el nombre exacto sobre el comodín. Las tiendas siguen en
# <slug>.${PLATFORM_DOMAIN} — nunca en www.<slug>.<dominio>.
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name ${PLATFORM_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://www.${PLATFORM_DOMAIN}$request_uri;
}

# ---------- HTTPS: SPA + API + estáticos ----------
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name .${PLATFORM_DOMAIN};

    # Certificado wildcard (*.dominio) -> requiere ACME DNS-01 (ver certbot
    # en docker-compose.yml). Ruta estándar de Let's Encrypt.
    ssl_certificate     /etc/letsencrypt/live/${PLATFORM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PLATFORM_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Headers de seguridad para lo que NO pasa por Django (SPA + estáticos).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;
    # CSP: la API va por mismo origen (connect-src 'self' + el exchange de
    # Google Identity Services: script, frame del botón, connect y stylesheet
    # en accounts.google.com); Google Fonts on-demand del storefront; imágenes
    # de tienda desde R2/dominio público variable (img-src https:); mapa
    # embebido de Google en "Contáctanos" (frame-src); 'unsafe-inline' en
    # style es inevitable: Vue escribe atributos style.
    # frame-src/frame-ancestors same-site (apex + *.dominio): el panel puede
    # iframear las webs públicas de tienda (vista previa del editor de
    # bloques) tanto por alias de path como por subdominio <slug>.<dominio>;
    # sitios ajenos siguen bloqueados (anti-clickjacking).
    # Misma whitelist que la CSP del SPA empaquetado en DaventProject/urls.py.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com; frame-src 'self' https://${PLATFORM_DOMAIN} https://*.${PLATFORM_DOMAIN} https://maps.google.com https://www.google.com https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://${PLATFORM_DOMAIN} https://*.${PLATFORM_DOMAIN}; form-action 'self'" always;
    # COOP: el botón de Google abre un popup que necesita postMessage de
    # vuelta — 'same-origin' lo aísla y el login quedaba en blanco.
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 10m;   # subidas de imágenes van por /api multipart

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

    # ----- API -> gunicorn (red interna, jamás expuesta al host) -----
    location /api/ {
        include /etc/nginx/snippets/proxy_api.conf;
    }

    # Login JWT: capa extra de rate-limit por IP.
    location = /api/token/ {
        limit_req zone=api_token burst=3 nodelay;
        include /etc/nginx/snippets/proxy_api.conf;
    }

    # Admin de Django vive detrás del mismo proxy.
    location /admin/ {
        include /etc/nginx/snippets/proxy_api.conf;
    }

    # Estáticos de Django (admin/DRF) y media local: volumen compartido ro.
    location /static/ {
        alias /srv/static/;
        autoindex off;
        expires 7d;
        add_header Cache-Control "public";
    }
    location /media/ {
        alias /srv/media/;
        autoindex off;
        expires 1h;
    }

    # Assets de Vite: fingerprinted -> caché largo e inmutable.
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # index.html nunca cacheado: el deploy del SPA se ve al instante.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA Vue Router (history mode): fallback a index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
