# Copiar a .env.development / .env.production según ambiente
VITE_API_BASE_URL=/api
# Dominio raíz de la plataforma: los links públicos de tienda son <slug>.<este dominio>
# Dev: localhost (mitienda.localhost:5173 resuelve a loopback en Chrome/Firefox)
VITE_PLATFORM_DOMAIN=localhost
VITE_APP_NAME=DAVENT
VITE_APP_TAGLINE=Gestión SaaS para e-commerce tecnológicos
# Firebase Phone Auth (verificación de celular por SMS — plan Spark, ~10 SMS/día
# gratis). Consola Firebase -> Configuración -> Tus apps -> </> (web app).
# Sin VITE_FIREBASE_API_KEY el botón "Verificar por SMS" queda deshabilitado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Login social (botones de Google y Facebook en login/registro — vacío = oculto).
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth
# client ID (tipo Web; agregar el origen del frontend en "Authorized JavaScript
# origins"). El MISMO valor va en GOOGLE_CLIENT_ID del .env del backend.
VITE_GOOGLE_CLIENT_ID=
# Facebook: developers.facebook.com -> tu app -> Configuración -> Básica ->
# "Identificador de la aplicación" (App ID, es público). El App SECRET va solo
# en FACEBOOK_APP_SECRET del backend — jamás acá. En "Inicio de sesión con
# Facebook" hay que registrar el dominio en "URI de redireccionamiento de OAuth
# válidos" (en dev, http://localhost:5173 viene pre-habilitado).
VITE_FACEBOOK_APP_ID=
