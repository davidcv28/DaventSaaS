# Copiar a .env.development / .env.production según ambiente
VITE_API_BASE_URL=/api
# Dominio raíz de la plataforma: los links públicos de tienda son <slug>.<este dominio>
# Dev: localhost (mitienda.localhost:5173 resuelve a loopback en Chrome/Firefox)
VITE_PLATFORM_DOMAIN=localhost
VITE_APP_NAME=DAVENT
VITE_APP_TAGLINE=Gestión SaaS para e-commerce tecnológicos
