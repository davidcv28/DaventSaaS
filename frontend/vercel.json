{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://davent-api.onrender.com/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://davent-api.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://davent-api.onrender.com/static/:path*" }
  ]
}
