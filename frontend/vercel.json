{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://davent.com.ar https://*.davent.com.ar https://daventsaas.onrender.com"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://daventsaas.onrender.com/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://daventsaas.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://daventsaas.onrender.com/static/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
