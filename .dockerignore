# Contexto de build de la API: nada de secretos ni basura local.
.git
.gitattributes
.env
.env.*
!*.env.example
venv/
**/venv/
**/__pycache__/
**/*.pyc
db.sqlite3
media/
staticfiles/
frontend/node_modules/
frontend/dist/
.dockerignore
docker-compose*.yml
.github/
.vscode/
*.log
nul
%TEMP%/
Thumbs.db
.DS_Store
# Material criptográfico y secretos locales: nunca en una capa de imagen.
# docker/certbot/ guarda el token de Cloudflare del ACME DNS-01 (chmod 600,
# no commiteado) — sin esta línea, `COPY . .` lo horneaba y build-push lo
# publicaba en GHCR.
docker/certbot/
.secrets/
**/*.pem
**/*.key
*.csr
# Temporales de herramientas/agentes (no deben entrar a ninguna imagen).
tmp*/
.agentsroom/
.claude/
.pnpm-store/
