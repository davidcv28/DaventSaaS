# Copiar a .env.development / .env.production según ambiente
VITE_API_BASE_URL=/api
# Dominio raíz de la plataforma: los links públicos de tienda son <slug>.<este dominio>
# Dev: localhost (mitienda.localhost:5173 resuelve a loopback en Chrome/Firefox)
VITE_PLATFORM_DOMAIN=localhost
# Subdominios de tienda <slug>.<dominio>: vacío = auto (on salvo onrender.com);
# '0' fuerza links <dominio>/<slug> (dominio propio apuntado a Render, que no
# enruta wildcard); '1' fuerza subdominios (VPS con DNS+TLS wildcard).
VITE_STORE_SUBDOMAINS=
VITE_APP_NAME=DAVENT
VITE_APP_TAGLINE=Gestión SaaS para e-commerce tecnológicos
# Login social (botón de Google en login/registro — vacío = oculto).
# OVERRIDE SOLO DE DEV: en prod el client ID lo sirve el backend en runtime
# via GET /api/config/ (env GOOGLE_CLIENT_ID) — no se hornea en el bundle.
# Acá solo sirve para levantar el front sin env del backend. Si se usa, es
# el MISMO valor: console.cloud.google.com -> Google Auth Platform ->
# Clientes -> tipo Web (agregar el origen en "Orígenes JS autorizados").
VITE_GOOGLE_CLIENT_ID=
