# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/

# Django
db.sqlite3
/media/
/staticfiles/

# Env / secrets — nunca subir .env reales
.env
.env.*
!*.env.example

# Frontend
node_modules/
frontend/dist/
# APKs firmadas generadas por `npm run release:apk` — jamás commitear
frontend/apk-dist/
# Páginas solo-dev (ej. set-token.html): jamás commitear ni shipear
frontend/dev-tools/

# Basura de Windows / IDE
nul
%TEMP%/
Thumbs.db
.DS_Store
.vscode/
*.log

# Capturas QA locales (los scripts qa_*.py / seed_bench.py sí se commitean)
qa/
_qa/
qa_out/
.qa-tmp/
.shots/
_v/
frontend/qa-look-harness.html
qa_token.tmp
.mcp.json
.agentsroom/handoff-transcript-*.txt
.agentsroom/handoff-summary-*.md
.agentsroom/fork-context-*.txt
.agentsroom/transfer-context-*.txt

# Directorios temporales de herramientas/agentes en la raíz (tmpXXXX):
# rompen `git add -A` y `git status`, e inflan el contexto de build.
/tmp*/
