# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/

# Django
db.sqlite3
/media/
/staticfiles/

# Env / secrets — nunca subir .env reales
.env
.env.*
!*.env.example

# Frontend
node_modules/
frontend/dist/
# APKs firmadas generadas por `npm run release:apk` — jamás commitear
frontend/apk-dist/
# Páginas solo-dev (ej. set-token.html): jamás commitear ni shipear
frontend/dev-tools/

# Basura de Windows / IDE
nul
%TEMP%/
Thumbs.db
.DS_Store
.vscode/
*.log

# Capturas QA locales (los scripts qa_*.py / seed_bench.py sí se commitean)
qa/
_qa/
qa_out/
.qa-tmp/
.shots/
_v/
frontend/qa-look-harness.html
qa_token.tmp
.mcp.json
.agentsroom/handoff-transcript-*.txt
.agentsroom/handoff-summary-*.md
.agentsroom/fork-context-*.txt
.agentsroom/transfer-context-*.txt

# Directorios temporales de herramientas/agentes en la raíz (tmpXXXX):
# rompen `git add -A` y `git status`, e inflan el contexto de build.
/tmp*/

# Store local de pnpm y configs de herramientas locales
.pnpm-store/
.claude/settings.local.json

# Temp local de esbuild/Vite en Windows
.tmpbuild/
.tmp_build/

# Artefactos de Playwright en la raiz
.pw-*

# Referencia de diseño (clon de awesome-design-skills, solo lectura)
awesome-design-skills/

# Prompts y logs generados por tools/ola.ps1 (los roles viven en .devin/agents/)
.devin/prompts/
.devin/logs/

# Residuos de pip y temporales de la raiz
/pip-*/
/.tmp_*/
/_tmp_*/
/.tmp*
frontend/.tmp/
frontend/visual-qa/
frontend/tmpout.css
/_credits_*

# Scripts/artefactos one-off de QA y diseño en la raíz (se regeneran;
# los seeds demo _seed_*.py son locales y leen imágenes ya borradas)
/_qa_*
/_tmp_*
/_pw_browsers/
/_pwtmp/
/_tmp_pw/
/pwtest-*/
/_bazar_qa/
/_seed_*.py

# Cache de Vite/Vitest
**/.vite/
